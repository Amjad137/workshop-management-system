{
  "name": "express-boilerplate",
  "version": "0.0.1-1",
  "main": "./dist/server.js",
  "type": "module",
  "scripts": {
    "test": "yarn run env:copy:test && NODE_ENV=test jest --coverage",
    "test:watch": "yarn run env:copy:test && NODE_ENV=test jest --coverage --watch",
    "start": "node ./dist/server.js",
    "start:local": "yarn run env:copy:local && yarn build:watch --onSuccess \"node ./dist/server.js\"",
    "start:local:qa": "yarn run env:copy:qa && yarn build:watch --onSuccess \"node ./dist/server.js\"",
    "start:local:staging": "yarn run env:copy:staging && yarn build:watch --onSuccess \"node ./dist/server.js\"",
    "start:qa": "yarn run build:qa && NODE_ENV=qa yarn run start",
    "start:staging": "yarn run build:staging && NODE_ENV=staging PORT=3100 yarn run start",
    "start:production": "yarn run build:production && NODE_ENV=production PORT=7050 yarn run start",
    "env:copy:test": "cp .env.test .env",
    "env:copy:local": "cp .env.local .env",
    "env:copy:qa": "cp .env.qa .env",
    "env:copy:staging": "cp .env.staging .env",
    "env:copy:production": "cp .env.production .env",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "build:check": "tsc --noEmit",
    "build": "tsup src/server.ts",
    "build:watch": "tsup src/server.ts --watch",
    "build:qa": "yarn run env:copy:qa && yarn run build",
    "build:staging": "yarn run env:copy:staging && yarn run build",
    "build:production": "yarn run env:copy:production && yarn run build",
    "seed": "tsup src/seed.ts && node ./dist/seed.js",
    "prepare": "husky install",
    "kill": "echo 'Enter port number' && read port && kill $(lsof -t -i:$port)",
    "release:pre": "yarn version --prerelease && yarn extract",
    "release:patch": "yarn version --patch && yarn extract",
    "release:minor": "yarn version --minor && yarn extract",
    "release:major": "yarn version --major && yarn extract",
    "extract": "node -p \"'export const VERSION = ' + JSON.stringify(require('./package.json').version) + ';'\" > src/version.ts && yarn format:fix && git add . && git commit -m 'build: version update' && git push --tags"
  },
  "author": "Amjath",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1148.0",
    "@aws-sdk/s3-request-presigner": "^3.1148.0",
    "@better-auth/mongo-adapter": "^1.7.7",
    "better-auth": "^1.7.7",
    "cls-rtracer": "^2.6.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "dotenv-expand": "^10.0.0",
    "express": "^4.18.2",
    "express-bearer-token": "^2.4.0",
    "express-query-parser": "^1.3.3",
    "express-winston": "^4.2.0",
    "helmet": "^7.1.0",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "mongoose": "^8.0.1",
    "nanoid": "^6.0.2",
    "nodemon": "^3.0.1",
    "winston": "^3.11.0",
    "yup": "^1.3.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.8.1",
    "@commitlint/config-conventional": "^17.8.1",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.10",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/lodash": "^4.14.202",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.0",
    "@types/supertest": "^2.0.16",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-etc": "^2.0.3",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-n": "^16.3.1",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-sonarjs": "^0.21.0",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2"
  },
  "engines": {
    "npm": "Unsupported. Use Yarn instead.",
    "yarn": ">= 1.22.19",
    "pnpm": "Unsupported. Use Yarn instead.",
    "node": ">= 16.17.0"
  },
  "tsup": {
    "clean": true,
    "format": "esm",
    "target": "node20",
    "outDir": "dist",
    "minify": true,
    "treeShake": true,
    "entry": [
      "src/server.ts"
    ]
  }
}